# hosts/*/hardware-configuration.nix wajib ter-track git: dengan flake, file
# yang tidak ter-track tidak dikopi ke store dan `nixos-rebuild --flake` gagal
# dengan error path tidak ada. Isinya UUID disk, bukan rahasia.
# Regenerate per mesin: nixos-generate-config --show-hardware-config

# Build results
result
result-*

# Secrets (jika menggunakan sops/agenix)
secrets/
*.age
*.secret

# Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
